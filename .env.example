# Copy to .env and adjust. docker compose reads this file.

# ---- Admin seed (created on first startup) ----
ADMIN_EMAIL=admin@openvitae.local
ADMIN_PASSWORD=changeme

# ---- Auth ----
JWT_SECRET=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth mode: "jwt" (built-in password login, default) or "proxy" (trust a forward-auth
# reverse proxy such as Authelia/Authentik that injects the identity as request headers).
AUTH_MODE=jwt
# Only used when AUTH_MODE=proxy. Header names match Authelia defaults.
PROXY_AUTH_EMAIL_HEADER=Remote-Email
PROXY_AUTH_NAME_HEADER=Remote-Name
PROXY_AUTH_GROUPS_HEADER=Remote-Groups
# Optional: require this group (from PROXY_AUTH_GROUPS_HEADER) to reach the admin.
PROXY_AUTH_REQUIRED_GROUP=
# Auto-create a local admin row the first time a proxy-authenticated user appears.
PROXY_AUTH_AUTO_PROVISION=true

# ---- Postgres ----
POSTGRES_USER=openvitae
POSTGRES_PASSWORD=openvitae
POSTGRES_DB=openvitae
# Consumed by the backend; host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg2://openvitae:openvitae@db:5432/openvitae

# ---- MinIO / object storage ----
S3_ACCESS_KEY=openvitae
S3_SECRET_KEY=openvitae-secret
S3_BUCKET=openvitae
S3_REGION=us-east-1
# Internal endpoint (backend -> minio over the compose network)
S3_ENDPOINT_URL=http://minio:9000
# Browser-reachable endpoint used to sign URLs the user's browser opens
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# ---- Frontend ----
# Internal API URL used for SSR and to proxy browser /api/* calls at runtime.
# In compose this is the service name; for local dev use http://localhost:8000.
SERVER_API_URL=http://api:8000
# Optional: set only to make the browser call an absolute API origin directly,
# bypassing the same-origin /api proxy. Left unset, the browser uses /api.
# NEXT_PUBLIC_API_URL=

# ---- CORS (backend) ----
CORS_ORIGINS=http://localhost:3000
