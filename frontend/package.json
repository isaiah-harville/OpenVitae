    "lucide-svelte": "^1.0.1",
    "marked": "^18.1.0",
    "postcss": "^8.5.29",
    "sanitize-html": "^2.18.0",
    "svelte": "^5.57.2",
    "svelte-dnd-action": "^0.9.80",
